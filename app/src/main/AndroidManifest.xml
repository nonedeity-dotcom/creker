<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        Usage access is a "special" permission: it cannot be granted from a runtime
        dialog, the user has to enable it on the system Settings screen. Declaring it
        is still required so the app shows up in that list.
    -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!--
        UsageStatsManager reports raw package names. To show a label and an icon for
        every one of them on Android 11+ the app needs visibility of installed
        packages. No package data ever leaves the device.
    -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!--
        Held by other apps (e.g. a habit tracker) to read device_usage via UsageProvider.
        protectionLevel="normal" means it's granted automatically to anything that declares
        it — no runtime dialog — but a random app still can't read this without knowing the
        exact permission name and asking for it explicitly.
    -->
    <permission
        android:name="com.creker.screentime.permission.READ_USAGE"
        android:protectionLevel="normal" />

    <!--
        Guards the write half of the provider. protectionLevel="signature" means only an app
        signed with the same key could ever hold it, i.e. nobody — this is a lock rather than an
        entry point. UsageProvider refuses insert/update/delete in code as well: this attribute
        can be lost in a manifest merge, the code check cannot.
    -->
    <permission
        android:name="com.creker.screentime.permission.WRITE_USAGE"
        android:protectionLevel="signature" />

    <application
        android:name=".ScreenTimeApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.CrekerScreenTime">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.CrekerScreenTime">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name=".data.provider.UsageProvider"
            android:authorities="com.creker.screentime.provider"
            android:exported="true"
            android:readPermission="com.creker.screentime.permission.READ_USAGE"
            android:writePermission="com.creker.screentime.permission.WRITE_USAGE" />
    </application>

</manifest>
