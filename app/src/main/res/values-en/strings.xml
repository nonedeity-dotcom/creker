    <string name="settings_sharing_section">Data for other apps</string>
    <string name="settings_sharing_body">Only apps with the switch on get the data. Everyone else gets no answer — to them it looks as if creker were not installed. Nothing goes to the internet: this exchange stays inside the phone.</string>
